{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuerdas Studio",
  "version": "0.1.0",
  "identifier": "studio.kuerdas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kuerdas Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist" }
  }
}
